# ECONVYX AI Environment Variables
# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# AI Intelligence Service (Google Gemini Flash)
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration (Supabase / PostgreSQL)
# If not provided, ECONVYX AI uses high-performance persistent local storage in server/data/
DATABASE_URL=postgresql://postgres.<PROJECT_ID>:<YOUR-DATABASE-PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<PROJECT_ID>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_<YOUR-PUBLISHABLE-KEY>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<YOUR-SECRET-KEY>

# JWT & Session Security
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# File Upload & Storage
STORAGE_DIR=./uploads
DATA_DIR=./server/data
MAX_FILE_SIZE_BYTES=10485760 # 10MB

# Frontend only: set to the deployed API origin plus /api (e.g. https://api.example.com/api).
# Leave blank for same-origin local development through the Vite proxy.
VITE_API_URL=

# Email / SMTP Configuration (for password reset & notifications)
# For Gmail: use smtp.gmail.com, port 587, your email, and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM_NAME="ECONVYX AI Security"
